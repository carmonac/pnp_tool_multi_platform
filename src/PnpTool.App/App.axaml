<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PnpTool.App.App"
             Name="PNP Tool"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Colours of the main window. The light ones are those of the Windows program. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F0F8FF" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#E1E6ED" />
          <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RibbonSeparatorBrush" Color="#D5DBE3" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5A6472" />
          <DropShadowEffect x:Key="IconHaloEffect" Color="#FFFFFF" BlurRadius="0" OffsetX="0" OffsetY="0" Opacity="0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E2126" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#262B33" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A414C" />
          <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#2A2F37" />
          <SolidColorBrush x:Key="RibbonSeparatorBrush" Color="#454C58" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#A9B2BF" />
          <DropShadowEffect x:Key="IconHaloEffect" Color="#FFFFFF" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.85" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://PnpTool/Views/RibbonStyles.axaml" />
  </Application.Styles>
</Application>
