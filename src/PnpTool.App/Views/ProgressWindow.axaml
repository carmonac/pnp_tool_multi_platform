<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PnpTool.App.Views.ProgressWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock Name="CaptionLabel" FontWeight="SemiBold" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <ProgressBar Name="Bar" Grid.Column="0" Minimum="0" Maximum="100" Height="16" />
      <TextBlock Name="PercentLabel" Grid.Column="1" Text="0%" MinWidth="40" TextAlignment="Right" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Name="EtaLabel" Grid.Column="0" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      <Button Name="CancelButton" Grid.Column="1" Width="36" Height="36" Padding="4" Background="Transparent" BorderThickness="0"
              IsCancel="True" Click="OnCancel">
        <Image Source="avares://PnpTool.Controls/Assets/cancel.png" />
      </Button>
    </Grid>
  </StackPanel>
</Window>
