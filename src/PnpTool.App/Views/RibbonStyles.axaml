<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A large button of the command bar: icon above, label below. -->
  <Style Selector="Button.ribbon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="MaxWidth" Value="110" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.ribbon Image">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Stretch" Value="Uniform" />
    <!-- The icons are those of the Windows program, drawn for a light window: on the dark
         theme a light halo keeps the dark ones in sight. On the light theme it is nothing. -->
    <Setter Property="Effect" Value="{DynamicResource IconHaloEffect}" />
  </Style>
  <Style Selector="Button.ribbon TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- A small button of the quick-access bar: icon only. -->
  <Style Selector="Button.quick">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.quick Image">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Effect" Value="{DynamicResource IconHaloEffect}" />
  </Style>

  <Style Selector="TextBlock.tipTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.tipText">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
</Styles>
