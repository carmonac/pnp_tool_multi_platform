<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PnpTool.Controls"
        x:Class="PnpTool.App.Views.SelectCardsWindow"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,70,Auto,70,*,Auto" Margin="14" ColumnSpacing="10" RowSpacing="12">
    <TextBlock Name="FromLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
    <controls:IntegerTextBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" MaxLength="4" />
    <TextBlock Name="ToLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" />
    <controls:IntegerTextBox x:Name="ToBox" Grid.Row="0" Grid.Column="3" MaxLength="4" />
    <ComboBox Name="FaceList" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch" />
    <CheckBox Name="CardsCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
    <CheckBox Name="ImagesCheck" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" />
    <Button Name="AcceptButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Width="40" Height="40" Padding="4"
            IsDefault="True" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom" Click="OnAccept">
      <Image Source="avares://PnpTool.Controls/Assets/ok.png" />
    </Button>
  </Grid>
</Window>
