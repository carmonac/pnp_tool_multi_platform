<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PnpTool.App.ViewModels"
        xmlns:ribbon="using:PnpTool.App.ViewModels.Ribbon"
        xmlns:views="using:PnpTool.App.Views"
        xmlns:controls="using:PnpTool.Controls"
        x:Class="PnpTool.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://PnpTool/Assets/app-icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Tooltip shared by the buttons of the command bar and of the quick-access bar. -->
    <DataTemplate x:Key="ButtonTip" DataType="ribbon:RibbonButtonViewModel">
      <StackPanel>
        <TextBlock Classes="tipTitle" Text="{Binding ToolTipTitle}" />
        <TextBlock Classes="tipText" Text="{Binding ToolTipDescription}" IsVisible="{Binding HasDescription}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Quick access. Original: RibbonQuickAccessToolBar. -->
    <ItemsControl Grid.Row="0" Name="QuickAccessBar" ItemsSource="{Binding QuickAccess}" Margin="8,6,8,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="ribbon:RibbonButtonViewModel">
          <Button Classes="quick" Command="{Binding Command}" AutomationProperties.Name="{Binding ToolTipTitle}">
            <ToolTip.Tip>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonTip}" />
            </ToolTip.Tip>
            <Image Source="{Binding Icon}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Command bar. Original: the WPF Ribbon with its five tabs. -->
    <views:RibbonTabControl Grid.Row="1" x:Name="CommandBar" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Margin="5,0,5,0" Padding="0">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="ribbon:RibbonTabViewModel">
          <TextBlock Text="{Binding Header}" FontSize="14" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="ribbon:RibbonTabViewModel">
          <Border Background="{DynamicResource RibbonBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="6,6" Height="96">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
              <!-- What some tabs show before their buttons: the lists that choose a style. -->
              <ContentControl Content="{Binding Leading}" IsVisible="{Binding Leading, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:RecentFilesList">
                    <Border BorderBrush="{DynamicResource RibbonSeparatorBrush}" BorderThickness="0,0,1,0" Padding="4,0,10,0" Margin="0,0,4,0">
                      <StackPanel VerticalAlignment="Center" Spacing="6" Width="260">
                        <TextBlock Text="{Binding Source={x:Static vm:MainWindowViewModel.RecentFilesLabel}}" />
                        <ComboBox Name="RecentList" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Owner.RecentFiles}" SelectedItem="{Binding Owner.SelectedRecentFile}"
                                  IsEnabled="{Binding Owner.RecentFiles.Count}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                  <DataTemplate DataType="vm:ProjectSettingsViewModel">
                    <Border BorderBrush="{DynamicResource RibbonSeparatorBrush}" BorderThickness="0,0,1,0" Padding="4,0,10,0" Margin="0,0,4,0">
                      <Grid Name="StyleSelector" ColumnDefinitions="Auto,230" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6" VerticalAlignment="Center">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding GroupText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Name="GroupList" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StyleText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Name="StyleList" HorizontalAlignment="Stretch" IsEnabled="{Binding HasStyles}"
                                  ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="ribbon:RibbonGroupViewModel">
                    <Border BorderBrush="{DynamicResource RibbonSeparatorBrush}" BorderThickness="0,0,1,0" Padding="4,0" Margin="0,0,4,0">
                      <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="ribbon:RibbonButtonViewModel">
                            <StackPanel Orientation="Horizontal">
                            <Button Classes="ribbon" Command="{Binding Command}" AutomationProperties.Name="{Binding ToolTipTitle}">
                                <ToolTip.Tip>
                                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonTip}" />
                                </ToolTip.Tip>
                                <StackPanel>
                                  <Image Source="{Binding Icon}" />
                                  <TextBlock Classes="label" Text="{Binding Label}" />
                                </StackPanel>
                              </Button>
                              <!-- The colour some buttons carry: the blank colour beside "add blank image". -->
                              <Button Classes="swatch" Name="SwatchButton" Command="{Binding SwatchCommand}" IsVisible="{Binding HasSwatch}"
                                      AutomationProperties.Name="{Binding SwatchName}"
                                      Width="18" Padding="2" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <Border Background="{Binding Swatch}" BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                                        Width="12" Height="40" CornerRadius="2" />
                              </Button>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </views:RibbonTabControl>

    <!-- Work area: the image panel and, at the right, the back image. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="5">
      <Border Grid.Column="0" Name="ImagePanelHost" Margin="0" CornerRadius="8" Padding="2" ClipToBounds="True"
              Background="{DynamicResource RibbonBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <views:ImagePanel x:Name="CardsPanel" DataContext="{Binding ImagePanel}" />
      </Border>
      <Border Grid.Column="1" Name="BackImageHost" Margin="5,0,0,0" IsVisible="{Binding SharedBack.IsVisible}">
        <views:SharedBackPanel x:Name="SharedBackPanel" DataContext="{Binding SharedBack}" />
      </Border>
    </Grid>

    <!-- Status line: counts, progress and zoom. -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,180" Margin="10,0,10,0" MinHeight="42">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
        <TextBlock Name="CountsLabel" Text="{Binding CountsText}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Name="StatusLabel" Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <ProgressBar Grid.Column="1" Name="ProgressBar" Margin="10,0" Height="14" VerticalAlignment="Center"
                   Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <controls:ZoomSlider Grid.Column="2" x:Name="ZoomSlider" Margin="5,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
