<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PnpTool.App.Views.ConfirmWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="18" Spacing="16">
    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
      <TextBlock Name="MessageText" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="YesButton" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" Click="OnYes" />
      <Button Name="NoButton" MinWidth="80" HorizontalContentAlignment="Center" Content="No" Click="OnNo" />
      <Button Name="CancelButton" MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
