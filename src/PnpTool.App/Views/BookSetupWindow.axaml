<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PnpTool.Controls"
        xmlns:vm="using:PnpTool.App.ViewModels"
        x:Class="PnpTool.App.Views.BookSetupWindow"
        x:DataType="vm:BookSetupViewModel"
        Width="470" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="controls|DecimalTextBox, controls|IntegerTextBox">
      <Setter Property="Width" Value="64" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="14" Spacing="10">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <TextBlock Name="PositionLabel" />
      <ComboBox Name="PositionBox" Grid.Column="1" ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}" HorizontalAlignment="Stretch" />
      <TextBlock Name="SpineLabel" Grid.Row="1" />
      <ComboBox Name="SpineBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SpineOptions}" SelectedItem="{Binding SelectedSpine}" HorizontalAlignment="Stretch" />
      <TextBlock Name="EdgeLabel" Grid.Row="2" />
      <ComboBox Name="EdgeBox" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EdgeOptions}" SelectedItem="{Binding SelectedEdge}" HorizontalAlignment="Stretch" />
      <TextBlock Name="MarksLabel" Grid.Row="3" />
      <ComboBox Name="MarksBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MarkOptions}" SelectedItem="{Binding SelectedMarks}" HorizontalAlignment="Stretch" />
    </Grid>
    <StackPanel Name="MarksPanel" Orientation="Horizontal" Spacing="8" MinHeight="32" IsVisible="{Binding MarksDrawn}">
      <TextBlock Name="MarginLabel" />
      <controls:DecimalTextBox x:Name="MarginBox" Text="{Binding MarginText}" />
      <TextBlock Name="CountLabel" />
      <controls:IntegerTextBox x:Name="CountBox" Text="{Binding CountText}" />
      <TextBlock Name="SizeLabel" />
      <controls:DecimalTextBox x:Name="SizeBox" Text="{Binding SizeText}" />
    </StackPanel>
    <controls:OkCancelButtons x:Name="Buttons" HorizontalAlignment="Right" Accepted="OnAccepted" Cancelled="OnCancelled" />
  </StackPanel>
</Window>
