<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PnpTool.Controls"
        xmlns:vm="using:PnpTool.App.ViewModels"
        x:Class="PnpTool.App.Views.TabletopWindow"
        x:DataType="vm:TabletopViewModel"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="controls|IntegerTextBox">
      <Setter Property="Width" Value="60" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox, TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <StackPanel Margin="16" Spacing="12">
    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <TextBlock Name="ColumnsLabel" />
      <controls:IntegerTextBox x:Name="ColumnsBox" Grid.Column="1" Text="{Binding ColumnsText}" />
      <CheckBox Name="RestrictionsCheck" Grid.Column="2" IsChecked="{Binding ApplyRestrictions}" />
      <TextBlock Name="RowsLabel" Grid.Row="1" />
      <controls:IntegerTextBox x:Name="RowsBox" Grid.Row="1" Grid.Column="1" Text="{Binding RowsText}" />
    </Grid>
    <TextBlock Name="SummaryBlock" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <TextBlock Name="FolderLabel" />
      <TextBox Name="FolderBox" Grid.Column="1" Text="{Binding Folder}" />
      <Button Name="FolderButton" Grid.Column="2" Width="34" Height="32" Padding="4" Click="OnPickFolder">
        <Image Source="avares://PnpTool/Assets/Icons/folder.png" />
      </Button>
      <TextBlock Name="FileNameLabel" Grid.Row="1" />
      <TextBox Name="FileNameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileName}" />
    </Grid>
    <controls:OkCancelButtons x:Name="Buttons" HorizontalAlignment="Right" Accepted="OnAccepted" Cancelled="OnCancelled" />
  </StackPanel>
</Window>
