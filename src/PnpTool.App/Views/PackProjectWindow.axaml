<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PnpTool.App.ViewModels"
        x:Class="PnpTool.App.Views.PackProjectWindow"
        x:DataType="vm:PackProjectViewModel"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="14" Spacing="10">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Name="FolderBox" Text="{Binding Folder}" />
      <Button Name="FolderButton" Grid.Column="1" Content="…" Width="34" Click="OnPickFolder" />
    </Grid>
    <TextBox Name="NameBox" Text="{Binding Name}" />
    <CheckBox Name="ZipBox" IsChecked="{Binding CreateZip}" />
    <CheckBox Name="DeleteBox" IsChecked="{Binding DeleteFiles}" IsVisible="{Binding CreateZip}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="14" VerticalAlignment="Center" />
      <Button Name="StartButton" Grid.Column="1" Width="48" Height="48" Padding="4" Background="Transparent"
              IsEnabled="{Binding !IsBusy}" Click="OnStart">
        <Image Source="avares://PnpTool/Assets/Icons/execute.png" />
      </Button>
    </Grid>
  </StackPanel>
</Window>
