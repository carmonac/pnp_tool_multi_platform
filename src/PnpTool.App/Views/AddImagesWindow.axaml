<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PnpTool.Controls"
        x:Class="PnpTool.App.Views.AddImagesWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="10">
    <RadioButton Name="PairsOption" GroupName="AddImages" IsChecked="True" />
    <RadioButton Name="ManyFrontsOption" GroupName="AddImages" />
    <RadioButton Name="ManyBacksOption" GroupName="AddImages" />
    <RadioButton Name="ManyBothOption" GroupName="AddImages" />
    <CheckBox Name="RememberOption" Margin="0,6,0,0" />
    <controls:OkCancelButtons HorizontalAlignment="Right" Accepted="OnAccepted" Cancelled="OnCancelled" />
  </StackPanel>
</Window>
