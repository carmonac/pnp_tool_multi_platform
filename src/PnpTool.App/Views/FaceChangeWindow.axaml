<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PnpTool.Controls"
        x:Class="PnpTool.App.Views.FaceChangeWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Name="Heading" FontWeight="SemiBold" TextWrapping="Wrap" />
    <RadioButton Name="FrontsOption" GroupName="FaceChange" IsChecked="True" />
    <RadioButton Name="BacksOption" GroupName="FaceChange" />
    <RadioButton Name="BothOption" GroupName="FaceChange" />
    <RadioButton Name="MatchOption" GroupName="FaceChange" />
    <controls:OkCancelButtons HorizontalAlignment="Right" Accepted="OnAccepted" Cancelled="OnCancelled" />
  </StackPanel>
</Window>
