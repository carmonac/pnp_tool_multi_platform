<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PnpTool.Controls"
             x:Class="PnpTool.Controls.LanguageComboBox">
  <ComboBox Name="Languages" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged">
    <ComboBox.ItemTemplate>
      <DataTemplate x:DataType="local:LanguageItem">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding Flag}" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Language.Name}" VerticalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
    </ComboBox.ItemTemplate>
  </ComboBox>
</UserControl>
