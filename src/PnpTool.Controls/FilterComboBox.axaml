<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PnpTool.Controls.FilterComboBox">
  <StackPanel Orientation="Horizontal" Spacing="6">
    <TextBlock Name="FilterLabel" VerticalAlignment="Center" />
    <ComboBox Name="FilterList" MinWidth="140" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" />
  </StackPanel>
</UserControl>
