<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PnpTool.Controls"
             x:Class="PnpTool.Controls.NumericBox">
  <Grid ColumnDefinitions="*,1.5*,*">
    <RepeatButton Name="DownButton" Grid.Column="0" Content="−" Padding="0" MinWidth="22"
                  Background="Transparent" BorderThickness="0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="Decrease" />
    <local:IntegerTextBox x:Name="ValueBox" Grid.Column="1" MaxLength="4" MinWidth="35"
                          BorderThickness="0" Padding="2" MinHeight="0"
                          HorizontalContentAlignment="Center" />
    <RepeatButton Name="UpButton" Grid.Column="2" Content="+" Padding="0" MinWidth="22"
                  Background="Transparent" BorderThickness="0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="Increase" />
  </Grid>
</UserControl>
