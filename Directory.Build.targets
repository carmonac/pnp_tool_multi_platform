<Project>
  <ItemGroup>
    <!-- Desktop only. Marks every assembly as macOS/Linux/Windows so the platform-compatibility
         analyzer (CA1416) accepts libraries that are limited to those OSes, such as PDFium. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
